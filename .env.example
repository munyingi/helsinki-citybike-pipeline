# Copy to .env and fill in. Never commit .env.
# Account identifier: Snowsight > bottom-left menu (your name) > Connect a tool to Snowflake
# > Account identifier, e.g. ABCDEFG-XY12345 (orgname-accountname)
SNOWFLAKE_ACCOUNT=ABCDEFG-XY12345
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=CITYBIKE_WH
# Absolute path is safest (dbt runs from the dbt/ folder)
SNOWFLAKE_PRIVATE_KEY_PATH=/full/path/to/helsinki-citybike-pipeline/keys/rsa_key.p8
